design-assets/

# The four cards the workflow rebuilds every 30 min live on the `cards`
# branch, not here -- see build_readme.py's CARDS_URL. They're still
# written into assets/ locally when a builder runs; they just don't
# belong to main any more.
assets/steam_card.png
assets/spotify_card.png
assets/last_commit_card.png
assets/wakatime_card.png

# The last-commit card's freshness anchor lives on the `cards` branch with
# the images, so the workflow never has to commit to main.
assets/last_commit_meta.json
assets/last_commit_url.txt
